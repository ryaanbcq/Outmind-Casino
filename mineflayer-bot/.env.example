# --- Bank bot (Mineflayer, logged into the public server) ---
MC_HOST=play.example.net
MC_PORT=25565
# Microsoft account used by the bank bot. MC_AUTH=microsoft opens the device-code
# flow once, the token cache lives in ./nmp-cache (gitignored).
MC_USERNAME=bank@example.com
MC_AUTH=microsoft
# Minecraft name of the casino owner: the only in-game account whose /msg are
# treated as admin orders.
ADMIN_USER=YourMinecraftName
# Optional tuning
BOT_GRACE_MS=15000
BOT_SILENT=0
BOT_DEBUG_SYS=0
BOT_NPC_ID=
PODIUM_NPC_IDS=
LEADERBOARD_EXCLUDE=

# --- Pterodactyl panel of the casino Paper server (bridge.js) ---
PTERO_PANEL_URL=https://panel.example.com
PTERO_API_KEY=ptlc_replace_me
PTERO_SERVER_ID=abcd1234

# --- Withdrawal quotas ---
# Fixed house cap per day, 0 = disabled (only the vault percentage applies)
CASHOUT_DAILY_MAX=0
# Percentage of the treasury the house can pay out per day
CASHOUT_DAILY_VAULT_PCT=30
# Per-player daily caps by rank
CASHOUT_PLAYER_MAX_GAMBLER=150000000
CASHOUT_PLAYER_MAX_INVESTOR=250000000
# Total invested amount that grants the Investor rank
INVESTOR_MIN=3000000

# --- Optional circuit breaker tuning (lib/guard.js) ---
BRIDGE_PUSH_SINGLE_MAX=250000000
BRIDGE_PUSH_REPEAT_MIN=5000000
BRIDGE_PUSH_REPEAT_MS=900000
BRIDGE_PUSH_NOTIFY=1
