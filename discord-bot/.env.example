# --- Discord application ---
DISCORD_BOT_TOKEN=replace_me
DISCORD_APP_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000
# Public invite shown to players
DISCORD_INVITE=https://discord.gg/replace_me

# Where the bank bot keeps its state files (balances.json, daily-cap.json, ...)
BOT_DIR=../mineflayer-bot
DISCORD_BOT_DIR=.
FONTS_DIR=./fonts

# Same panel as the bank bot (used to relay console signals to the game)
PTERO_PANEL_URL=https://panel.example.com
PTERO_API_KEY=ptlc_replace_me
PTERO_SERVER_ID=abcd1234

# 32-byte hex key encrypting the Minecraft session tokens of auto-deposit users
AUTODEPOSIT_KEY=replace_with_64_hex_chars

# Channels (ids) and features
CHAIN_CHANNEL=
CHAIN_DOUBLE_CHANCE=0.40
PUBLIC_AI_CHANNEL=
ADMIN_AI_CHANNEL=
# "<discordId>:<label>,<discordId>:<label>" allowed to talk to the admin AI
ADMIN_AI_ALLOWED=
BOOST_OFFER=on
LEADERBOARD_EXCLUDE=

# --- LLM desks (optional, both disabled when the keys are empty) ---
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
PUBLIC_AI_MODEL=glm-5.2
PUBLIC_AI_REASONING=medium
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
# Sends player-written text (#ask-outmind transcripts, #feedback) to the OpenClaw
# agent so it keeps notes. That agent has a shell: leave this off unless the
# agent runs without tools. Off by default.
PUBLIC_AI_VAULT_DIGEST=off
AGENT_ALERTS_FILE=../agent-alerts.jsonl
AGENT_OUTBOX_FILE=../agent-outbox.jsonl
AGENT_CLICKS_FILE=../agent-clicks.jsonl
